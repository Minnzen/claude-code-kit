{
  "name": "@claude-code-kit/ui",
  "version": "0.4.0",
  "description": "Terminal UI component library for claude-code-kit \u2014 Spinner, ProgressBar, Divider and more",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check src/"
  },
  "dependencies": {
    "@claude-code-kit/ink-renderer": "workspace:*",
    "@claude-code-kit/shared": "workspace:*",
    "chalk": "5.6.2",
    "chokidar": "4.0.3",
    "figures": "6.1.0",
    "marked": "17.0.5",
    "strip-ansi": "7.2.0",
    "usehooks-ts": "^3.1.1",
    "zod": "4.3.6"
  },
  "peerDependencies": {
    "react": "~19.2.0",
    "@claude-code-kit/agent": "^0.4.0"
  },
  "peerDependenciesMeta": {
    "@claude-code-kit/agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@claude-code-kit/agent": "workspace:*",
    "@types/marked": "6.0.0",
    "react": "~19.2.4",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Minnzen/claude-code-kit.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/Minnzen/claude-code-kit",
  "bugs": "https://github.com/Minnzen/claude-code-kit/issues",
  "keywords": [
    "terminal",
    "cli",
    "tui",
    "react",
    "components",
    "repl",
    "select",
    "spinner",
    "claude-code",
    "ai-agent"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
