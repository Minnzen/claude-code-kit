{
  "name": "@claude-code-kit/agent",
  "version": "0.4.0",
  "description": "Headless agent framework for claude-code-kit \u2014 LLM query loop, tool execution, multi-provider",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check src/"
  },
  "dependencies": {
    "zod": "4.3.6"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "openai": "^6.33.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "zod-to-json-schema": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.82.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "openai": "6.33.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Minnzen/claude-code-kit.git",
    "directory": "packages/agent"
  },
  "homepage": "https://github.com/Minnzen/claude-code-kit",
  "bugs": "https://github.com/Minnzen/claude-code-kit/issues",
  "keywords": [
    "agent",
    "llm",
    "claude",
    "openai",
    "tool-use",
    "ai"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
